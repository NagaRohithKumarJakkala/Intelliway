# ─── LiteLLM Proxy ───────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-change-me-to-a-secure-master-key
LITELLM_SALT_KEY=change-me-to-a-secure-random-salt

# ─── TimescaleDB ─────────────────────────────────────────────────
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-to-a-secure-db-password

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-to-a-secure-redis-password

# ─── Ollama (optional — only if running on host) ─────────────────
# Podman: use host.containers.internal to reach host services
# Docker: use host.docker.internal
OLLAMA_BASE_URL=http://host.containers.internal:11434

# Non-local automatic routing sends the full conversation to Jev.
JEV_API_KEY=
# Blank uses the SDK default service URL. No SDK retries are performed.
JEV_BASE_URL=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=10
# Optional routing JSON override, loaded at startup; changes require restart.
# Configure every automatic pool in routing JSON with matching LiteLLM aliases.
# auto-quality should contain only operator-selected frontier models.
# Set operator-verified USD input/output costs per million tokens; null means unknown.
ROUTING_CONFIG_PATH=

# ─── External Provider Keys (or manage via Admin UI) ─────────────
OPENROUTER_API_KEY=

# ─── Gateway (Python app running outside Docker) ─────────────────
LITELLM_URL=http://127.0.0.1:4000
SEMANTIC_ROUTER_URL=http://127.0.0.1:8899
