# ─── LiteLLM Proxy ───────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-change-me-to-a-secure-master-key
LITELLM_SALT_KEY=change-me-to-a-secure-random-salt

# ─── TimescaleDB ─────────────────────────────────────────────────
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-to-a-secure-db-password

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-to-a-secure-redis-password

# ─── Ollama (optional — only if running on host) ─────────────────
# Podman: use host.containers.internal to reach host services
# Docker: use host.docker.internal
OLLAMA_BASE_URL=http://host.containers.internal:11434

# ─── External Provider Keys (or manage via Admin UI) ─────────────
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ─── Gateway (Python app running outside Docker) ─────────────────
LITELLM_URL=http://127.0.0.1:4000
SEMANTIC_ROUTER_URL=http://127.0.0.1:8899
