# ─── LiteLLM Proxy ───────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-change-me-to-a-secure-master-key
LITELLM_SALT_KEY=change-me-to-a-secure-random-salt
GATEWAY_API_KEY=
GATEWAY_RPM_LIMIT=60
GATEWAY_AUDIT_HMAC_KEY=replace-with-a-random-secret
GATEWAY_CIRCUIT_FAILURES=3
GATEWAY_CIRCUIT_RESET_SECONDS=30
GATEWAY_MAX_BODY_BYTES=26214400
GATEWAY_REDIS_HOST=127.0.0.1
GATEWAY_REDIS_PORT=6379
UPSTREAM_TIMEOUT=30
PUBLIC_DOMAIN=localhost

# ─── TimescaleDB ─────────────────────────────────────────────────
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-to-a-secure-db-password

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-to-a-secure-redis-password

# ─── Observability ───────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-secure-grafana-password
OTEL_SERVICE_NAME=intelliway-gateway

# ─── Ollama (optional — only if running on host) ─────────────────
# Podman: use host.containers.internal to reach host services
# Docker: use host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─── External Provider Keys (or manage via Admin UI) ─────────────
OPENROUTER_API_KEY=

# ─── Gateway (Python app running outside Docker) ─────────────────
LITELLM_URL=http://127.0.0.1:4000
SEMANTIC_ROUTER_URL=http://127.0.0.1:8899
